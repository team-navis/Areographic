{
  "name": "marswalk-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1 --port ${MW_PORT:-5173} --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port ${MW_PREVIEW_PORT:-4173} --strictPort",
    "capture:stage1": "node tests/stage1.capture.mjs",
    "capture:rover": "node tests/rover.capture.mjs",
    "capture:stage2": "node tests/stage2.capture.mjs",
    "capture:integration": "node tests/integration.capture.mjs",
    "capture:stage3": "node tests/stage3.capture.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.1.1",
    "playwright-core": "1.49.0",
    "vite": "5.4.11"
  }
}
